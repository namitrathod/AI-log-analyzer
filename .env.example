# ─────────────────────────────────────────────────────────────
# Copy this file to .env:   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Ollama URL — use Docker gateway IP so the container can reach Ollama
# Find your IP with: docker network inspect ai-log-analyzer_log-analyzer-net | grep Gateway
AI_API_URL=http://172.18.0.1:11434

# Ollama model — must be pulled first with: ollama pull llama3.2
AI_MODEL=llama3.2

# Max requests per minute
RATE_LIMIT_PER_MINUTE=10
